<?xml version="1.0" encoding="utf-8"?>
<!--
  The window shown between tapping the launcher icon and the first Flutter frame.
  Drawn with platform drawables only (no Flutter engine), so it uses the brand
  green and the mark generated by scripts/make_branding.py.
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
